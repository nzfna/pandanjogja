# Neon: Dashboard > Connection Details > salin "Pooled connection" string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# isi acak panjang, buat dengan: openssl rand -base64 32
AUTH_SECRET=
# akun pemilik (dibuat/di-reset lewat npm run db:setup, tidak ada halaman daftar)
SEED_OWNER_USERNAME=pemilik
SEED_OWNER_PASSWORD=
# nomor WA format 62812xxxx (tanpa + dan spasi)
NEXT_PUBLIC_OWNER_WA=
NEXT_PUBLIC_DEV_WA=
# AI pemilik (tanpa ini, chatbot pemilik pakai template — fitur tidak mati).
# 1) GROQ_API_KEY di https://console.groq.com (gratis, tanpa kartu kredit)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# 2) Cadangan bila Groq kena limit: buat Token di Cloudflare > My Profile > API Tokens,
#    Account ID ada di dashboard Cloudflare. Gratis 10.000 "Neurons"/hari.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# batas total pertanyaan chatbot publik per hari (semua IP) supaya kuota gratis aman
# (hanya request yang lolos guard yang mengurangi kuota ini)
ASK_DAILY_LIMIT=1000
# HMAC untuk token riwayat chat (opsional; kosong = pakai AUTH_SECRET)
CHAT_HISTORY_SECRET=
# CAPTCHA waiting list. Ganti nilainya untuk merotasi/merevoke semua token lama.
CAPTCHA_SECRET=
# alert saat 429 melonjak (opsional). Webhook menerima JSON POST.
SECURITY_ALERT_WEBHOOK=
SECURITY_ALERT_429_THRESHOLD=25
SECURITY_ALERT_WINDOW_MIN=5
SECURITY_ALERT_COOLDOWN_MIN=10
# alamat Pandan Jogja 1 (tampil di kartu lokasi beranda; kosongkan kalau belum mau ditampilkan)
NEXT_PUBLIC_ADDRESS=
# domain produksi untuk Open Graph & sitemap (default sudah benar untuk deploy Vercel ini)
NEXT_PUBLIC_SITE_URL=https://pandanjogja.vercel.app
